# Application
PROJECT_NAME=Synapse
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Database Connection (Hosted PostgreSQL / Local PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/synapse

# Authentication (JWT)
# In production, JWT_SECRET_KEY must be a non-default secret of at least 32 bytes (256 bits)
JWT_SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth Credentials (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI & Embedding Providers
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-4b-instruct-2507
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GOOGLE_API_KEY=

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1536
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@synapse.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
